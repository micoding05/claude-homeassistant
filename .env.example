# Home Assistant Configuration Management Environment Variables
# Copy this file to .env in your project root and fill in your actual values

# Home Assistant Configuration
HA_TOKEN=your_home_assistant_long_lived_access_token_here
HA_URL=http://your_homeassistant_host:8123

# SSH Configuration for rsync operations
# This must match a Host entry in your ~/.ssh/config
HA_HOST=your_homeassistant_host
HA_REMOTE_PATH=/config/

# Data repository (Nutzdaten)
# Code and data are separate repositories. This repo holds only the tooling;
# the HA configuration, runtime state and environment snapshots live in a
# separate PRIVATE repository with this layout:
#
#   $HA_DATA_DIR/ha/         Home Assistant config (mirror of /config/)
#   $HA_DATA_DIR/tracking/   environment snapshots
#
# Relative paths are resolved against the project root.
HA_DATA_DIR=../claude-homeassistant-data

# Tooling paths (optional - defaults provided)
VENV_PATH=venv
TOOLS_PATH=tools
ETC_PATH=etc

# BACKUP_DIR defaults to $HA_DATA_DIR/backups and is intentionally NOT set here.
# Never point it inside this repository: a backup tarball contains your full HA
# configuration, which must not live in the public tooling repo.

# Instructions:
# 1. Copy this file to .env in your project root: cp .env.example .env
# 2. Edit .env with your actual Home Assistant details
# 3. Set up SSH access to your Home Assistant instance
# 4. Create the private data repository:
#      mkdir -p ../claude-homeassistant-data
#      git -C ../claude-homeassistant-data init
# 5. Run: make paths   to verify everything resolves correctly
# 6. Run: make pull    to sync your configuration into the data repo
