# Home Assistant Configuration Management - .gitignore

# ==========================================================
# BOUNDARY: Home Assistant Nutzdaten gehoeren NICHT hierher
# ==========================================================
# Code und Daten sind getrennte Repositories. Die HA-Konfiguration,
# der Runtime-State und die Tracking-Snapshots liegen im privaten
# Daten-Repo (HA_DATA_DIR, Standard: ../claude-homeassistant-data).
#
# Diese Regeln fangen den Fall ab, dass HA-Daten versehentlich wieder
# in diesem oeffentlichen Repo landen.
config/
ha/
data/
.storage/
.ha_tracking/
secrets.yaml
!templates/*.example

# Python
venv/
venv
# .venv normally ignores itself via the .gitignore that python -m venv writes
# inside it. Do not rely on that - a rebuild with a different tool would expose
# the whole dependency tree in this public repo.
.venv/
.venv
__pycache__/
*.py[cod]
*.pyc
*.pyo
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Backups
backups/
*.backup
*.bak
*.tar.gz

# Temporary files
*.tmp
*.temp
.cache/
temp/

# Logs
*.log

# Environment variables
.env
.env.local

# Node modules (if using any JS tools)
node_modules/

# SSH keys (if accidentally placed here)
*.pem
*.key
id_rsa*

# Database files
*.db
*.db-shm
*.db-wal

# Claude Code configuration and workspace data
.claude/

# Personal scratch notes - may reference real hosts and paths
.claude-notes.md

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Documentation builds
docs/_build/

# PyCharm
.idea/

# Jupyter Notebook
.ipynb_checkpoints

# Spyder
.spyderproject
.spyproject

# Rope
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Development tools
.pre-commit-cache/
.flake8
.pylint.d/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Development artifacts
.python_check.log
*.log
