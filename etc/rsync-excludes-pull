# ===========================================
# RSYNC EXCLUDES FOR: make pull (HA → Local)
# Less restrictive - pull most files for reference
# ===========================================

# Database and log files (too large, not needed locally)
home-assistant_v2.db*
*.db-shm
*.db-wal
*.log*

# Sensitive .storage files (never pull)
.storage/auth/
.storage/auth/**
.storage/auth_cache/
.storage/auth_cache/**
.storage/auth_provider.homeassistant
.storage/http.auth
.storage/esphome.encryption_keys
.storage/cloud
.storage/application_credentials
.storage/core.uuid

# Tooling data - belongs in the data repo's tracking/, never in ha/
.ha_tracking/

# zigbee2mqtt runtime state: changes constantly, is useless as a local
# reference, and only shows up as permanent drift. Its configuration.yaml is
# still pulled.
zigbee2mqtt/database.db
zigbee2mqtt/state.json
zigbee2mqtt/coordinator_backup.json
zigbee2mqtt/log/

# Custom add-ons and themes (managed separately)
custom_components/
custom_icons/
themes/

# Runtime/cache directories
.cloud/
deps/
tts/
__pycache__/

# Large directories not needed locally
backups/
image/
tmp_backups/
www/

# Miscellaneous
.uuid
secrets.yaml.example

# Temporary files
*.tmp
*.temp
